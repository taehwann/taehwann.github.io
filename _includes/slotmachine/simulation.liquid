<div markdown="0">
  <div class="simulation-controls">
    <label for="spin-count"
      >Spins per configuration<select id="spin-count">
        <option value="1000000" selected>1,000,000</option>
        <option value="10000000">10,000,000</option>
      </select></label
    ><button id="simulate" class="primary">Run Simulation <span aria-hidden="true">↗</span></button
    ><button id="reset-simulation" class="text-button">Reset</button>
  </div>
  <p id="simulation-status" class="small" role="status">Ready. Run the experiments to populate both interactive graphs.</p>
  <div class="chart-legend"><span class="legend-one">J-heavy</span><span class="legend-two">A–D-heavy</span></div>
  <figure>
    <div id="chart" class="chart"><p>Run the experiments to trace observed RTP.</p></div>
    <figcaption>Interactive graph 1. Cumulative observed return versus spins, with a 96% reference line.</figcaption>
  </figure>
  <details class="math-details">
    <summary>Inspect sampled payout statistics</summary>
    <div class="table-wrap">
      <table>
        <caption>
          Fixed-length simulation results
        </caption>
        <thead>
          <tr>
            <th scope="col">Measure</th>
            <th scope="col">J-heavy</th>
            <th scope="col">A–D-heavy</th>
          </tr>
        </thead>
        <tbody id="simulation-table"></tbody>
      </table>
    </div>
    <p class="small">Win rate counts spins with any payout.</p>
  </details>
</div>
